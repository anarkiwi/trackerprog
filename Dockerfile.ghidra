# Ghidra headless oracles for tuneprog: the facts-driven high P-Code export and
# the P-Code emulator semantic oracle over deity-informant's 6510 SLEIGH module.
# Multistage: Ghidra and the dependency install are cached layers, so a source
# edit here re-runs only the last one.

ARG GHIDRA_URL=https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.1.2_build/ghidra_12.1.2_PUBLIC_20260605.zip

FROM eclipse-temurin:21-jdk AS ghidra
ARG GHIDRA_URL
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl unzip ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /tmp/ghidra.zip "$GHIDRA_URL" \
    && unzip -q /tmp/ghidra.zip -d /opt \
    && mv /opt/ghidra_* /opt/ghidra \
    && rm /tmp/ghidra.zip

FROM eclipse-temurin:21-jdk AS run
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghidra /opt/ghidra /opt/ghidra
ENV GHIDRA_INSTALL_DIR=/opt/ghidra
WORKDIR /src
# Dependencies first, from pyproject alone, so a source edit does not reinstall
# them; then compile+install deity-informant's 6510 language into the Ghidra
# tree so -processor 6510:LE:16:default resolves under headless.
COPY pyproject.toml /src/
RUN python3 -c "import tomllib; print('\\n'.join(tomllib.load(open('pyproject.toml','rb'))['project']['dependencies']))" \
        > /tmp/req.txt \
    && pip3 install --break-system-packages -r /tmp/req.txt \
    && deity-informant emit-sleigh -o "$GHIDRA_INSTALL_DIR/Ghidra/Processors/6510/data/languages"
COPY . /src
RUN pip3 install --break-system-packages --no-deps -e .
CMD ["sh", "ghidra/6510/headless/run.sh"]
